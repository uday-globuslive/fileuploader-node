<%- include('partials/header') %>

<div class="card">
  <h1>Upload files</h1>
  <form action="/upload" method="POST" enctype="multipart/form-data" class="upload-form" id="uploadForm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="file" name="files" multiple required />
    <button type="submit">Upload</button>
  </form>
  <p class="muted">You can select up to <%= maxUploadFiles %> files at once, up to <%= maxUploadSize %> each.</p>

  <div class="progress-wrap" id="uploadProgressWrap" hidden>
    <div class="progress-track">
      <div class="progress-bar" id="uploadProgressBar"></div>
    </div>
    <span class="progress-label" id="uploadProgressLabel">0%</span>
  </div>
</div>

<div class="card">
  <h2>My files</h2>
  <% if (!files.length) { %>
    <p class="muted">You haven't uploaded any files yet.</p>
  <% } else { %>
    <table class="file-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Size</th>
          <th>Uploaded</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% files.forEach(function(f) { %>
          <tr>
            <td><%= f.originalName %></td>
            <td><%= (f.size / 1024).toFixed(1) %> KB</td>
            <td><%= new Date(f.uploadedAt).toLocaleString() %></td>
            <td class="actions">
              <a href="/download/<%= f.id %>">Download</a>
              <form action="/delete/<%= f.id %>" method="POST" class="inline-form" data-confirm="Delete this file?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="link-btn danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<script src="/js/upload.js" defer></script>

<%- include('partials/footer') %>
