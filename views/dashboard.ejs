<%- include('partials/header') %>

<div class="card">
  <h1>Upload a file</h1>
  <form action="/upload" method="POST" enctype="multipart/form-data" class="upload-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="file" name="file" required />
    <button type="submit">Upload</button>
  </form>
</div>

<div class="card">
  <h2>My files</h2>
  <% if (!files.length) { %>
    <p class="muted">You haven't uploaded any files yet.</p>
  <% } else { %>
    <table class="file-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Size</th>
          <th>Uploaded</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% files.forEach(function(f) { %>
          <tr>
            <td><%= f.originalName %></td>
            <td><%= (f.size / 1024).toFixed(1) %> KB</td>
            <td><%= new Date(f.uploadedAt).toLocaleString() %></td>
            <td class="actions">
              <a href="/download/<%= f.id %>">Download</a>
              <form action="/delete/<%= f.id %>" method="POST" class="inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="link-btn danger" onclick="return confirm('Delete this file?')">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('partials/footer') %>
