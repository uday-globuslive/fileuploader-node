# Server
PORT=3000
NODE_ENV=development

# Session secret - set a long random string in production
SESSION_SECRET=change-this-to-a-long-random-string

# Default admin account seeded on first run.
# If ADMIN_PASSWORD is left empty, a random password is generated
# and printed to the console ONCE on first startup - copy it immediately.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Max upload size in bytes (default 20 MB)
MAX_UPLOAD_BYTES=20971520
